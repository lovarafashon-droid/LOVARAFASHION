# XPay server-side settings — add these in hosting Environment Variables, never in GitHub
XPAY_CHECKOUT_URL=
XPAY_API_KEY=
XPAY_MERCHANT_ID=
XPAY_WEBHOOK_SECRET=
XPAY_CURRENCY=EGP
PUBLIC_SITE_URL=https://your-production-domain.example

# Required later for the webhook to update Firestore securely
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ImageKit — keep the private key in Vercel Environment Variables, never in GitHub
IMAGEKIT_PRIVATE_KEY=
