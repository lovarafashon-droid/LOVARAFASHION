rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function ownsShop(shopId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/shops/$(shopId))
        && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid == request.auth.uid;
    }

    function isPublicShop(shopId) {
      return exists(/databases/$(database)/documents/shops/$(shopId))
        && get(/databases/$(database)/documents/shops/$(shopId)).data.active == true
        && get(/databases/$(database)/documents/shops/$(shopId)).data.expiresAt is timestamp
        && request.time < get(/databases/$(database)/documents/shops/$(shopId)).data.expiresAt;
    }

    function ownsActiveShop(shopId) {
      return ownsShop(shopId) && isPublicShop(shopId);
    }

    match /users/{userId} {
      allow get: if isAdmin() || isOwner(userId);
      allow list: if isAdmin();
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == 'user';
      // Customers may update their profile, but cannot promote themselves or assign a shop.
      allow update: if isAdmin()
        || (isOwner(userId)
          && request.resource.data.role == resource.data.role
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['storeId']));
      allow delete: if isAdmin();
    }

    // Existing LOVARA catalog remains public and can only be changed by admins.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // A customer account may submit one store request. Only the owner can finish a draft;
    // only admins can approve/reject it or change its review fields.
    match /storeRequests/{userId} {
      allow get: if isAdmin() || isOwner(userId);
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'draft'
        && request.resource.data.storeName is string
        && request.resource.data.storeName.size() >= 2
        && request.resource.data.storeName.size() <= 80
        && request.resource.data.supportPhone is string
        && request.resource.data.supportPhone.size() >= 8
        && request.resource.data.supportPhone.size() <= 20
        && request.resource.data.imageUrl == ''
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'ownerEmail', 'storeName', 'supportPhone', 'imageUrl',
          'status', 'createdAt', 'updatedAt'
        ]);
      allow update: if isAdmin()
        || (isOwner(userId)
          && resource.data.ownerUid == request.auth.uid
          && resource.data.status in ['draft', 'rejected']
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.status == 'draft'
          && request.resource.data.storeName is string
          && request.resource.data.storeName.size() >= 2
          && request.resource.data.storeName.size() <= 80
          && request.resource.data.supportPhone is string
          && request.resource.data.supportPhone.size() >= 8
          && request.resource.data.supportPhone.size() <= 20
          && request.resource.data.imageUrl == ''
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'ownerEmail', 'storeName', 'supportPhone', 'imageUrl', 'status', 'updatedAt'
          ]));
      allow delete: if isAdmin();
    }

    // Shop pages are fetched by their direct slug; no public collection listing exists.
    match /shops/{shopId} {
      allow get: if isAdmin() || ownsShop(shopId) || isPublicShop(shopId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();

      // Each merchant writes only beneath their approved shop. The parent shop's active
      // subscription is rechecked for reads; all writes go through the trusted API so it can
      // atomically enforce the product quota and plan feature entitlements.
      match /products/{productId} {
        allow read: if isAdmin() || ownsShop(shopId) || isPublicShop(shopId);
        allow create, update, delete: if isAdmin();
      }

      // Partner checkout orders are created by trusted server endpoints/webhooks.
      // Merchants can read only their own shop's orders. Status updates and cancellations
      // must pass through the server API, which validates ownership and legal transitions.
      match /orders/{orderId} {
        allow get, list: if isAdmin() || ownsShop(shopId);
        allow create: if false;
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    match /orders/{orderId} {
      // Orders are created and customer cancellations are processed only by trusted server endpoints.
      allow create: if false;
      allow read: if isAdmin() || (request.auth != null && (
        resource.data.userId == request.auth.uid
        || (request.auth.token.email_verified == true && resource.data.customer.email == request.auth.token.email)
      ));
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /returns/{returnId} {
      allow create: if request.resource.data.keys().hasAll([
        'firstName', 'lastName', 'phone', 'orderNumber', 'type',
        'productName', 'reason', 'status', 'date'
      ])
      && request.resource.data.status == 'pending'
      && request.resource.data.firstName is string
      && request.resource.data.lastName is string
      && request.resource.data.phone is string
      && request.resource.data.orderNumber is string
      && request.resource.data.productName is string
      && request.resource.data.type in ['return', 'exchange']
      && request.resource.data.firstName.size() <= 80
      && request.resource.data.lastName.size() <= 80
      && request.resource.data.phone.size() <= 40
      && request.resource.data.orderNumber.size() <= 80
      && request.resource.data.productName.size() <= 300;
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.status in ['pending', 'approved', 'rejected'];
      allow delete: if isAdmin();
    }

    match /visitors/{visitorId} {
      allow create, update: if true;
      allow read, delete: if isAdmin();
    }

    match /promoCodes/{codeId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /employees/{employeeId} {
      allow read, write: if isAdmin();
    }

    match /notificationTokens/{tokenId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
